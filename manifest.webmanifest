    { "name": "الصندوق", "url": "./index.html#/cashbox", "icons": [{ "src": "icon.svg", "sizes": "any" }] },
    { "name": "التقارير", "url": "./index.html#/reports", "icons": [{ "src": "icon.svg", "sizes": "any" }] }
